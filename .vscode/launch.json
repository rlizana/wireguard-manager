{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run wgm CLI",
      "type": "debugpy",
      "request": "launch",
      "module": "wgm",
      "args": [],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Run wgm CLI with Arguments",
      "type": "debugpy",
      "request": "launch",
      "module": "wgm",
      "args": "${input:args}",
      "argsPrompt": true,
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Test wgm",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-v"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ],
  "inputs": [
    {
      "id": "args",
      "type": "promptString",
      "description": "Arguments for wgm CLI",
      "default": "list"
    }
  ]
}
